                "default": "entity_alphatest",
                "enchanted": "entity_alphatest_glint"
            },
            "textures": {
                "default": "textures/items/mc/diamond_shovel",
                "enchanted": "textures/misc/enchanted_item_glint"
            },
            "geometry": {
                "default": "geometry.cb.item_weapon",
                "offhand": "geometry.cb.item_weapon.offhand"
            },
            "animations": {
                "default": "animation.cb.item_weapon"
            },
            "scripts": {
                "animate": [
                    "default"
                ]
            },
            "render_controllers": [
                {
                    "controller.render.cb_weapon": "c.item_slot == 'main_hand'"
                },
                {
                    "controller.render.cb_weapon.offhand": "c.item_slot == 'off_hand'"
                }
            ]
        }
    }
}